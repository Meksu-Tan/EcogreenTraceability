APP_NAME="EODS API"
APP_ENV=local
APP_KEY=base64:2yTgU/Pj3aVjEjzShx9GD8VQvvJwinRLff+JH5ixLLk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Default connection → PostgreSQL eudr_dev ──────────────────────────────
DB_CONNECTION=eudr_ts

# ─── eudr_ts — Primary App Database (PostgreSQL) ───────────────────────────
DB_TS_CONNECTION=pgsql
DB_TS_HOST=127.0.0.1
DB_TS_PORT=5432
DB_TS_DATABASE=eudr_dev
DB_TS_USERNAME=eudr_app
DB_TS_PASSWORD=Ecogreen123!
DB_TS_SSLMODE=disable
DB_TS_CHARSET=utf8
DB_TS_TIMEOUT=10
DB_TS_PERSISTENT=false

# ─── OEE MySQL — External (Packaging/Label integration) ────────────────────
# Spesifikasi server belum diketahui — isi saat sudah tersedia
# OEE_DB_HOST=
# OEE_DB_PORT=3309
# OEE_DB_DATABASE=oee_756
# OEE_DB_USERNAME=
# OEE_DB_PASSWORD=

# ─── DCS Flowmeter / Airflow Historian — External MySQL ────────────────────
