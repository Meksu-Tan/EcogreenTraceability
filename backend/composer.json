{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "binarytorch/larecipe": "^2.9",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "nwidart/laravel-modules": "*",
        "spatie/laravel-permission": "^6.25"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Admin\\": "Modules/Admin/app/",
            "Modules\\Auth\\": "Modules/Auth/app/",
            "Modules\\Dashboard\\": "Modules/Dashboard/app/",
            "Modules\\Manufacturer\\": "Modules/Manufacturer/app/",
            "Modules\\Material\\": "Modules/Material/app/",
            "Modules\\Plant\\": "Modules/Plant/app/",
            "Modules\\Shared\\": "Modules/Shared/app/",
            "Modules\\Storage\\": "Modules/Storage/app/",
            "Modules\\Supplier\\": "Modules/Supplier/app/",
            "Modules\\Tank\\": "Modules/Tank/app/",
            "Modules\\Transaction\\": "Modules/Transaction/app/",
            "Modules\\Inquiry\\": "Modules/Inquiry/app/",
            "Database\\Factories\\": [
                "database/factories/",
                "Modules/Admin/database/factories/",
                "Modules/Auth/database/factories/",
                "Modules/Dashboard/database/factories/",
                "Modules/Inquiry/database/factories/",
                "Modules/Manufacturer/database/factories/",
                "Modules/Material/database/factories/",
                "Modules/Plant/database/factories/",
                "Modules/Shared/database/factories/",
                "Modules/Storage/database/factories/",
                "Modules/Supplier/database/factories/",
                "Modules/Tank/database/factories/",
                "Modules/Transaction/database/factories/"
            ],
            "Database\\Seeders\\": [
                "database/seeders/",
                "Modules/Admin/database/seeders/",
                "Modules/Auth/database/seeders/",
                "Modules/Dashboard/database/seeders/",
                "Modules/Inquiry/database/seeders/",
                "Modules/Manufacturer/database/seeders/",
                "Modules/Material/database/seeders/",
                "Modules/Plant/database/seeders/",
                "Modules/Shared/database/seeders/",
                "Modules/Storage/database/seeders/",
                "Modules/Supplier/database/seeders/",
                "Modules/Tank/database/seeders/",
                "Modules/Transaction/database/seeders/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
